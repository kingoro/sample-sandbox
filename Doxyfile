PROJECT_NAME           = "Common Utility"
PROJECT_BRIEF          = "Memory Buffer and C Event Utility specifications"
OUTPUT_DIRECTORY       = build/docs/c-api
INPUT                  = docs/c-api-main.md \
                         memory-buffer/include \
                         memory-buffer/examples \
                         Utility/event/include \
                         Utility/event/src \
                         Utility/event/tests \
                         Utility/event/fuzz
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/c-api-main.md

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
GENERATE_LATEX         = NO
QUIET                  = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
HAVE_DOT               = NO
PREDEFINED             = __cplusplus=1
